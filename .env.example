# Copy to .env.local for `vercel dev`, or set in the Vercel project's
# Environment Variables settings for production.

# Required — server-side only, read by api/facilitator.mjs.
# Never expose this to client-side code.
ANTHROPIC_API_KEY=

# Optional — model used by the "Ask Bloom" facilitator. Defaults to
# claude-opus-5. For a live-event budget, a cheaper/faster model such as
# claude-sonnet-5 or claude-haiku-4-5 is worth considering — this is a
# short Q&A facilitator, not a task that needs Opus-tier reasoning.
FACILITATOR_MODEL=claude-opus-5
